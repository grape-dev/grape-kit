{
  "name": "@grape-dev/grape-kit",
  "version": "0.1.0",
  "description": "Grape DevOps pipeline tools for headless coding agents (opencode/hermes etc.) — contract-driven thin shell over grape CLI",
  "type": "module",
  "main": "src/server.mjs",
  "bin": {
    "grape-kit-mcp": "./grape-kit-mcp.mjs",
    "grape-kit": "./grape-kit.mjs"
  },
